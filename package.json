{
   "name": "stronghold",
   "version": "1.0.0",
   "description": "Telegram bot for herowarsbot",
   "main": "app.js",
   "scripts": {
      "start": "node server.js",
      "db:drop": "npx sequelize-cli db:drop",
      "db:create": "npx sequelize-cli db:create",
      "db:migrate": "npx sequelize-cli db:migrate",
      "db:seed:all": "npx sequelize-cli db:seed:all",
      "seed": "npx sequelize-cli db:seed:all",
      "seed:undo": "npx sequelize-cli db:seed:undo:all",
      "vercel-build": "echo 'Build step - migrations should be run manually'"

   },
   "dependencies": {
      "cors": "^2.8.5",
      "dotenv": "^16.3.1",
      "express": "^4.18.2",
      "pg": "^8.16.3",
      "pg-hstore": "^2.3.4",
      "sequelize": "^6.37.7",
      "sequelize-cli": "^6.6.3"
   },
   "devDependencies": {
      "nodemon": "^3.0.1"
   },
   "engines": {
      "node": ">=16.0.0"
   }
}
